{
  "name": "@eliware/log",
  "type": "module",
  "version": "1.1.7",
  "description": "A Node.js logging library.",
  "module": "index.mjs",
  "types": "index.d.ts",
  "files": [
    "index.mjs",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": "./index.mjs",
      "types": "./index.d.ts"
    }
  },
  "scripts": {
    "test": "npx --node-options=\"--experimental-vm-modules --no-warnings\" jest --detectOpenHandles --silent --coverage",
    "test:gaps": "npm test -- --coverageReporters=text 2>&1 | awk '!/100%/'",
    "lint": "npx oxlint ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eliware/log.git"
  },
  "keywords": [
    "logging",
    "logger",
    "nodejs",
    "debugging",
    "console",
    "log",
    "winston"
  ],
  "author": "Eli Sterling <eli@eliware.org>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/eliware/log/issues"
  },
  "homepage": "https://github.com/eliware/log#readme",
  "devDependencies": {
    "jest": "^30.4.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/?(*.)+(spec|test).[jt]s?(x)",
      "**/?(*.)+(spec|test).mjs"
    ]
  },
  "dependencies": {
    "winston": "^3.17.0"
  }
}
