{
  "name": "@eliware/log",
  "version": "13.0.0",
  "type": "module",
  "description": "Structured ESM logging for Node.js with redaction and defensive serialization, backed by Winston.",
  "keywords": [
    "logging",
    "logger",
    "nodejs",
    "debugging",
    "console",
    "log",
    "winston",
    "structured-logging",
    "structured-logger",
    "redaction",
    "serialization",
    "child-logger"
  ],
  "private": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "./src/index.mjs",
  "files": [
    "src/",
    "docs/",
    "README.md",
    "AGENTS.md",
    "LICENSE",
    "RELEASE_NOTES.md",
    "examples/",
    "specs/",
    ".env.example"
  ],
  "scripts": {
    "test": "eliware-test",
    "lint": "eliware-test --lint",
    "audit": "eliware-test --audit",
    "format": "eliware-test --format",
    "format:check": "eliware-test --format-check",
    "typecheck": "tsc --project tsconfig.json",
    "pack": "eliware-test --pack"
  },
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "@eliware/redact": "^13.0.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eliware/test": "^13.0.0",
    "typescript": "^7.0.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.mjs"
    ],
    "collectCoverageFrom": [
      "src/**/*.mjs"
    ],
    "coverageReporters": [
      "text",
      "json-summary"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      }
    }
  },
  "prettier": {
    "printWidth": 100,
    "tabWidth": 2,
    "useTabs": false,
    "semi": true,
    "singleQuote": false,
    "quoteProps": "as-needed",
    "jsxSingleQuote": false,
    "trailingComma": "all",
    "bracketSpacing": true,
    "bracketSameLine": false,
    "arrowParens": "always",
    "proseWrap": "preserve",
    "endOfLine": "lf"
  },
  "author": "Eliware <eliware@eliware.org>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eliware/log.git"
  },
  "homepage": "https://github.com/eliware/log#readme",
  "bugs": {
    "url": "https://github.com/eliware/log/issues"
  },
  "eliware": {
    "id": "E-102",
    "apply": [
      "general",
      "library",
      "npm-published"
    ]
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.mjs"
    }
  },
  "sideEffects": false,
  "types": "./src/index.d.ts"
}
