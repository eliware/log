{
    "name": "@eliware/log",
    "type": "module",
    "version": "2.4.0",
    "description": "Structured, secure ESM logging for Node.js with redaction and defensive serialization, backed by Winston.",
    "main": "src/index.mjs",
    "types": "src/index.d.ts",
    "sideEffects": false,
    "files": [
        "src",
        "README.md",
        "LICENSE",
        "RELEASE_NOTES.md",
        "examples"
    ],
    "exports": {
        ".": {
            "import": "./src/index.mjs",
            "types": "./src/index.d.ts"
        }
    },
    "scripts": {
        "test": "eliware-test",
        "lint": "eliware-test --lint",
        "typecheck": "tsc --project tsconfig.json",
        "pack": "npm pack --dry-run"
        ,"audit": "npm audit --omit=dev --audit-level=moderate"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/eliware/log.git"
    },
    "keywords": [
        "logging",
        "logger",
        "nodejs",
        "debugging",
        "console",
        "log",
        "winston",
        "structured-logging",
        "structured-logger",
        "redaction",
        "serialization",
        "child-logger"
    ],
    "author": "Eli Sterling <eli@eliware.org>",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/eliware/log/issues"
    },
    "homepage": "https://github.com/eliware/log#readme",
    "engines": {
        "node": ">=20"
    },
    "publishConfig": {
        "access": "public"
    },
    "devDependencies": {
        "@eliware/test": "^3.0.0",
        "typescript": "^7.0.2"
    },
    "dependencies": {
        "winston": "^3.17.0"
    }
}
